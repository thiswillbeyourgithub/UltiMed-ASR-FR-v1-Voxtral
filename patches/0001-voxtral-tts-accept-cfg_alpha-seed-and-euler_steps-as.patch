@@ -3053,6 +3055,89 @@ class OmniOpenAIServingSpeech(OpenAIServing, AudioMixin):
         self._track_ref_audio_artifact_warmup(request_id, qwen3_ref_audio_warmup_artifact_key)
         return request_id, generator, tts_params
 
+    def _apply_voxtral_request_overrides(self, request, sampling_params_list):
+        """Route Voxtral TTS's flat request fields to where the model reads them.
+
+        Local fork. Three of Voxtral's levers have no upstream request route, so a
+        client can only reach them by restarting the server with a different deploy
+        YAML:
+
+        * ``cfg_alpha`` -> stage 0 ``extra_args["cfg_alpha"]``, read per request by
+          ``VoxtralTTSForConditionalGeneration._extract_cfg_alpha``.
+        * ``euler_steps`` -> stage 0 ``extra_args["voxtral_euler_steps"]``, read per
+          request by ``_extract_euler_steps`` in the same class.
+        * ``seed`` -> stage 0 ``extra_args["voxtral_noise_seed"]``, which pins the
+          Gaussian each frame's flow-matching ODE starts from. This mirrors the
+          ``qwen3_tts_request_seed`` line above and exists for the same reason: the
+          plain ``SamplingParams.seed`` set there is arithmetically inert for
+          Voxtral, because stage 0 hands vLLM's sampler a vocab-wide -inf row with a
+          single finite entry (``fake_logits_for_audio_tokens``), so the winning
+          token is forced whatever the sampler decides. The audio is produced beside
+          that path, in ``make_omni_output``.
+        * ``acoustic_temperature`` -> stage 1's sampling temperature, the per-request
+          twin of the server's startup knob. Stage 1 is a deterministic codec
+          decoder, so this is expected to change nothing; it is routed anyway so the
+          claim can be tested without a restart.
+
+        ``extra_params`` stays the lower-level route and WINS on conflict: it is the
+        explicit "put this in extra_args" escape hatch, and silently overriding it
+        from a convenience field would make the escape hatch untrustworthy.
+
+        Note the whole extra_args mechanism is gated on stage 0's deploy YAML
+        ``default_sampling_params.extra_args`` being non-empty: that is what sets
+        ``has_sampling_extra_args`` (``engine/stage_init_utils.py``), and the model
+        runner only builds ``sampling_extra_args`` when it is true. Keep a default
+        ``cfg_alpha`` in the deploy config or none of this reaches the model.
+
+        Parameters
+        ----------
+        request : OpenAICreateSpeechRequest
+            The parsed speech request.
+        sampling_params_list : list[SamplingParams] | None
+            Per-stage sampling params, possibly still the engine's shared default
+            list (copied here before mutation if so).
+
+        Returns
+        -------
+        list[SamplingParams] | None
+            The list to generate with, unchanged when nothing applies.
+        """
+        if self._tts_model_type != "voxtral_tts" or not sampling_params_list:
+            return sampling_params_list
+
+        explicit_extras = request.extra_params or {}
+        # (extra_args key, requested value) pairs; None values mean "not requested".
+        stage0_extras = {
+            "cfg_alpha": getattr(request, "cfg_alpha", None),
+            "voxtral_euler_steps": getattr(request, "euler_steps", None),
+            "voxtral_noise_seed": request.seed,
+        }
+        stage0_extras = {
+            key: value for key, value in stage0_extras.items() if value is not None and key not in explicit_extras
+        }
+        acoustic_temperature = getattr(request, "acoustic_temperature", None)
+        wants_stage1 = acoustic_temperature is not None and len(sampling_params_list) > 1
+        if not stage0_extras and not wants_stage1:
+            return sampling_params_list
+
+        if sampling_params_list is self.engine_client.default_sampling_params_list:
+            import copy
+
+            sampling_params_list = copy.deepcopy(sampling_params_list)
+
+        if stage0_extras:
+            if sampling_params_list[0].extra_args is None:
+                sampling_params_list[0].extra_args = {}
+            sampling_params_list[0].extra_args.update(stage0_extras)
+        if wants_stage1:
+            sampling_params_list[1].temperature = acoustic_temperature
+        logger.info(
+            "Applied Voxtral request overrides: stage0=%s stage1_temperature=%s",
+            stage0_extras,
+            acoustic_temperature if wants_stage1 else None,
+        )
+        return sampling_params_list
+
     async def _generate_pcm_chunks(self, generator, request_id: str):
         """Yield raw PCM byte chunks from the engine generator.
 
