From bb5e10b8422918944893e6074d3883d1bfc3adad Mon Sep 17 00:00:00 2001
From: thiswillbeyourgithub
 <26625900+thiswillbeyourgithub@users.noreply.github.com>
Date: Fri, 31 Jul 2026 20:10:56 +0200
Subject: [PATCH 1/4] voxtral tts: accept cfg_alpha, seed and euler_steps as
 request fields

OpenAICreateSpeechRequest has no model_config, so pydantic v2's default
extra='ignore' drops any unknown flat key with a 200 response. A client
sending {"cfg_alpha": 1.5} therefore looked like it worked while every
request in fact ran at the server's startup default, and the only way to
reach the knob was to nest it in extra_params. Same for the seed: the flat
seed lands in SamplingParams.seed, which is arithmetically inert for Voxtral
because stage 0 feeds vLLM's sampler a vocab-wide -inf row with one finite
entry, so the winning token is forced regardless.

Declare the three Voxtral levers as real fields (cfg_alpha, euler_steps,
acoustic_temperature) and route them, plus the existing seed, in
_apply_voxtral_request_overrides: the first three into stage 0's extra_args
where the model reads them, acoustic_temperature into stage 1's sampling
temperature. extra_params keeps working and still wins on conflict, so the
low-level escape hatch stays trustworthy.

The model-side readers for voxtral_noise_seed and voxtral_euler_steps come
in the next commit; cfg_alpha already had one.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../entrypoints/openai/protocol/audio.py      | 40 +++++++++
 .../entrypoints/openai/serving_speech.py      | 85 +++++++++++++++++++
 2 files changed, 125 insertions(+)

diff --git a/vllm_omni/entrypoints/openai/protocol/audio.py b/vllm_omni/entrypoints/openai/protocol/audio.py
index 9a85886..6e2de23 100644
--- a/vllm_omni/entrypoints/openai/protocol/audio.py
+++ b/vllm_omni/entrypoints/openai/protocol/audio.py
@@ -96,6 +96,46 @@ class OpenAICreateSpeechRequest(BaseModel):
         ge=0,
         description="Per-request initial chunk size override. If null, computed dynamically based on server load.",
     )
+    # --- Voxtral TTS knobs (local fork) ---------------------------------------
+    # Upstream exposes these three only through `extra_params` (cfg_alpha) or not
+    # at all (euler_steps, acoustic_temperature). They are promoted to top-level
+    # fields here because this model is pydantic-permissive: it has no
+    # `model_config`, so pydantic v2's default extra='ignore' silently DROPS any
+    # unknown flat key with a 200 response, which makes a client that sends
+    # `{"cfg_alpha": 1.5}` look like it worked while every request in fact ran at
+    # the server's startup default. A declared field is the only way that mistake
+    # becomes visible. `extra_params` keeps working and still wins on conflict
+    # (see _apply_voxtral_request_overrides in serving_speech.py).
+    cfg_alpha: float | None = Field(
+        default=None,
+        gt=0.0,
+        description="Voxtral TTS classifier-free-guidance scale for the stage-0 "
+        "flow-matching acoustic transformer. Higher sticks more tightly to the "
+        "text at the cost of naturalness; 1.0 disables CFG and produces "
+        "phonetically plausible but off-text audio. Server default (deploy YAML "
+        "extra_args.cfg_alpha) applies when unset.",
+    )
+    euler_steps: int | None = Field(
+        default=None,
+        ge=1,
+        le=64,
+        description="Voxtral TTS Euler ODE / NFE step count for the stage-0 "
+        "flow-matching acoustic transformer (n_decoding_steps). More steps means "
+        "steadier audio for linearly more compute per frame. Applied only when "
+        "every request sharing a decode step asks for the same value, and it "
+        "forces the eager path because the CUDA graphs are captured at one fixed "
+        "step count. Model default (params.json, else 7) applies when unset.",
+    )
+    acoustic_temperature: float | None = Field(
+        default=None,
+        ge=0.0,
+        le=2.0,
+        description="Voxtral TTS sampling temperature for stage 1 (audio_tokenizer). "
+        "Exposed for parity with the server's startup knob; note stage 1 is a "
+        "deterministic codec decoder with no sampling path, so this is expected to "
+        "be a no-op and is not the lever for output variation (use seed / "
+        "cfg_alpha / euler_steps).",
+    )
     extra_params: dict[str, Any] | None = Field(
         default=None,
         description=("Optional model-specific parameters passed directly to the model's extra_args."),
