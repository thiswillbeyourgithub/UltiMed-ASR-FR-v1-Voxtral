# Optional docker-compose overrides for this repository. Copy to `.env` next to
# docker-compose.yml; every one of them has a working default, so an empty (or
# absent) .env is fine.
#
# All three are read by docker-compose.yml only, not by any code in this repo.

# Host uid/gid the container runs as, so ./cache stays host-owned. They are also
# passed to the build as APP_UID / APP_GID, which bakes a matching /etc/passwd
# entry (vLLM calls getpass.getuser() at startup and dies without one).
# Defaults: 1000 / 1000. Set them to `id -u` / `id -g` if yours differ.
VOXTRAL_UID=1000
VOXTRAL_GID=1000

# How many NVIDIA GPUs to reserve for the service. Default: all.
VOXTRAL_GPU_COUNT=all

# Compose project name, i.e. the prefix of the created container/network names.
# Default: the directory name.
# COMPOSE_PROJECT_NAME=voxtral
